# =============================================================================
# Café Cloud — qué NO entra en el contexto de build de ninguna imagen
# =============================================================================
# En TICKET-001 todavía no hay Dockerfiles, pero el archivo se crea ya: cuando
# aparezca el primer build, el contexto tiene que estar limpio desde el inicio,
# y sobre todo tiene que ser imposible que un `.env` acabe dentro de una imagen.

# Git
.git
.gitignore
.gitattributes

# Secretos y configuración local. `.env.example` sí entra, es documentación.
.env
.env.*
!.env.example
*.pem
*.key

# Base de contexto y configuración de las herramientas de desarrollo.
# No se versionan y no pintan nada dentro de una imagen.
.doc
.claude
CLAUDE.md

# Artefactos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
poetry.toml

# Caches de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Infraestructura y datos locales: los scripts de init se montan como volumen,
# no se copian a ninguna imagen de aplicación.
infra/
docker-compose.yml
docker-compose.override.yml
Makefile
data/
*.db
*.sqlite
*.sqlite3
dump.rdb

# Logs
*.log
logs/

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
.AppleDouble
