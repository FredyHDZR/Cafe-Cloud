# Café Cloud — variables de entorno.
#
# No hace falta copiar este archivo para arrancar: `docker-compose.yml` declara el mismo valor por
# defecto para cada variable. Para cambiar algo, `cp .env.example .env` y editarlo; `.env` no se
# versiona.
#
# Todas las credenciales de aqui son de desarrollo local: el entorno es efimero, solo escucha en
# loopback y se destruye con `docker compose down -v`.

# Interfaz del host donde se publican los puertos. 0.0.0.0 para alcanzarlos desde otro equipo.
HOST_BIND_IP=127.0.0.1

# Nivel de log de todos los procesos: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO


# Postgres
#
# Los nombres y contraseñas de rol los consume `infra/postgres/init/01-schemas-roles.sql` en el
# primer arranque: cambiarlos con el volumen `pgdata` ya creado no tiene efecto sin `down -v`. Una
# contraseña con caracteres reservados de URL (`@`, `:`, `/`, `#`) va codificada en porcentaje.

# Superusuario del contenedor. Ni los servicios ni Alembic lo usan: cada cadena de migraciones corre
# con el rol dueño de su esquema, que es lo que hace que ADR-006 lo imponga Postgres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cafecloud

# Puerto publicado en el host.
POSTGRES_PORT=5432

# Rol de orders-service: dueño del esquema `orders` (ADR-006).
ORDERS_DB_USER=orders_rw
ORDERS_DB_PASSWORD=orders_dev_pw

# Rol de processor-service: dueño de `processor` y limitado a SELECT y UPDATE de tres columnas
# sobre `orders.orders`. La migracion 0001 de orders-service lee este nombre para conceder.
PROCESSOR_DB_USER=processor_rw
PROCESSOR_DB_PASSWORD=processor_dev_pw


# Redis
#
# Sin contraseña: nodo unico de desarrollo. El AOF con `appendfsync everysec` lo fija el `command:`
# del Compose porque es un requisito de durabilidad de ADR-001.

# Puerto publicado en el host.
REDIS_PORT=6379


# MongoDB
#
# Nodo unico, sin replica set y sin autenticacion. La coleccion y sus indices los crea
# `infra/mongo/init/01-notifications-indexes.js` en el primer arranque.

# Base de datos de notificaciones.
MONGO_DB=cafecloud

# Puerto publicado en el host.
MONGO_PORT=27017


# orders-service
#
# DATABASE_URL y REDIS_URL no se ponen aqui: las compone el Compose a partir de las variables de
# arriba, y componerlas dos veces es la forma mas facil de que dejen de coincidir. El host es
# siempre `postgres` y `redis`, no `localhost`, que dentro de un contenedor es el propio contenedor.

# Nombre en el campo `service` de cada linea de log y en la respuesta de /health.
ORDERS_SERVICE_NAME=orders-service

# Base de Redis dentro del nodo.
ORDERS_REDIS_DB=0

# Puerto publicado en el host; dentro del contenedor uvicorn escucha en 8000.
ORDERS_SERVICE_PORT=8001


# Publicador de outbox de orders-service
#
# Contenedor propio con la misma imagen que la API y una sola replica: el orden de `orders.created`
# solo se conserva con un unico publicador (ADR-002). Estas variables las comparten los dos
# publicadores del sistema.

# Nombre en el campo `service` de sus logs, distinto del de la API para filtrar por proceso.
ORDERS_PUBLISHER_SERVICE_NAME=orders-outbox-publisher

# Periodo del bucle de polling en milisegundos y filas por ciclo (ADR-002).
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100

# Reintento por fila: next_attempt_at = now() + min(base * 2^attempts, max). Agotados los intentos
# la fila se marca con `failed_at` y no se borra: la fuente de verdad ya esta en Postgres.
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=1.0
OUTBOX_BACKOFF_MAX_SECONDS=300.0

# Recorte del stream en cada XADD (ADR-001).
OUTBOX_STREAM_MAXLEN=10000

# Purga: cada cuantos ciclos corre, filas por tabla y ciclo, y que se considera viejo. Las claves de
# idempotencia se borran una hora despues de expirar, para no tocar la ventana de 24 h de ADR-003.
OUTBOX_PURGE_EVERY_CYCLES=1500
OUTBOX_PURGE_BATCH_SIZE=1000
OUTBOX_RETENTION_HOURS=24
IDEMPOTENCY_PURGE_GRACE_HOURS=1


# processor-service
#
# Su esquema tiene cadena de Alembic y contenedor de migraciones propios; `make migrate` corre las
# dos cadenas.

# Nombre en el campo `service` de sus logs.
PROCESSOR_SERVICE_NAME=processor-service

# Puerto publicado en el host: el proceso consumidor sirve tambien /health y /metrics.
PROCESSOR_SERVICE_PORT=8002

# Base de Redis dentro del nodo. Tiene que coincidir con la de orders-service.
PROCESSOR_REDIS_DB=0

# Stream de entrada, grupo de consumo y nombre dentro del grupo. Vacio da `processor-<hostname>`.
CONSUMER_STREAM=orders.created
CONSUMER_GROUP=processor
CONSUMER_NAME=

# Espera maxima del XREADGROUP en milisegundos y mensajes por lectura. Un lote no gana nada aqui:
# la preparacion tarda de 2 a 5 s por mensaje y se procesan en serie.
CONSUMER_BLOCK_MS=5000
CONSUMER_BATCH_SIZE=1

# Pausa tras un fallo de lectura del stream, en segundos.
CONSUMER_ERROR_PAUSE_SECONDS=1.0

# Ventana de la preparacion simulada, en segundos. El tiempo real medido viaja como `processing_ms`.
PREP_MIN_SECONDS=2.0
PREP_MAX_SECONDS=5.0


# Publicador de outbox de processor-service
#
# Mismo codigo y mismas variables OUTBOX_* que el de orders-service, publicando en
# `orders.completed`. No purga claves de idempotencia: el esquema `processor` no las tiene.
PROCESSOR_PUBLISHER_SERVICE_NAME=processor-outbox-publisher


# notifier-service
#
# Dos procesos sobre la misma imagen y en contenedores separados: la API y el consumidor. Ninguno se
# conecta a Postgres, porque `orders.completed` es autosuficiente por contrato.

# Nombre de cada proceso en el campo `service` de sus logs.
NOTIFIER_SERVICE_NAME=notifier-service
NOTIFIER_CONSUMER_SERVICE_NAME=notifier-consumer

# Base de Redis dentro del nodo. Tiene que coincidir con la de processor-service.
NOTIFIER_REDIS_DB=0

# Puerto publicado en el host; dentro del contenedor uvicorn escucha en 8000.
NOTIFIER_SERVICE_PORT=8003

# Puerto publicado del consumidor: es un segundo objetivo de scrape, no una segunda API.
NOTIFIER_CONSUMER_PORT=8004

# Coleccion de notificaciones. El Compose no la pasa: el nombre lo fijan de hecho el script de init
# y el healthcheck de Mongo.
# MONGO_COLLECTION=notifications

# Stream, grupo y nombre del consumidor. El Compose no los pasa, y no conviene ponerlos en un `.env`
# compartido: tienen el mismo nombre que los de processor-service.
# CONSUMER_STREAM=orders.completed
# CONSUMER_GROUP=notifier
# CONSUMER_NAME=

# Espera maxima del XREADGROUP y mensajes por lectura. Aqui un lote si compensa: escribir una
# notificacion son unos milisegundos.
# CONSUMER_BLOCK_MS=5000
# CONSUMER_BATCH_SIZE=10


# Resiliencia de los consumidores (ADR-004)
#
# El runtime de consumidor es el mismo en los dos servicios. El Compose no pasa ninguna de estas
# variables: cada proceso usa el valor por defecto de su codigo y aqui solo se documentan.

# Backoff en proceso: min(base * 2^(intento-1), max) * uniforme(jitter_min, jitter_max). El jitter
# evita que dos consumidores reintenten a la vez y sincronicen su carga sobre el almacen.
# CONSUMER_MAX_ATTEMPTS=3
# CONSUMER_BACKOFF_BASE_SECONDS=1.0
# CONSUMER_BACKOFF_MAX_SECONDS=30.0
# CONSUMER_BACKOFF_JITTER_MIN=0.8
# CONSUMER_BACKOFF_JITTER_MAX=1.2

# Stream de mensajes muertos; vacio significa `<CONSUMER_STREAM>.dlq`. Sin consumidor automatico a
# proposito: se miran con `make dlq-inspect` y se reprocesan con `make dlq-replay`.
# CONSUMER_DLQ_STREAM=

# Janitor de mensajes colgados (XAUTOCLAIM), como tarea de fondo del propio consumidor. Bajar la
# inactividad minima por debajo de lo que tarda un mensaje hace que un consumidor lento se robe a si
# mismo el trabajo en vuelo.
# JANITOR_INTERVAL_SECONDS=15
# JANITOR_MIN_IDLE_MS=60000
# JANITOR_BATCH_SIZE=50
# JANITOR_MAX_DELIVERIES=5

# Cotas de espera de processor-service sobre Postgres, en milisegundos. Sin ellas la transaccion
# espera indefinidamente a una ajena atascada; un fallo por lock_timeout entra en el backoff.
# DB_LOCK_TIMEOUT_MS=3000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Seleccion de servidor de MongoDB, en milisegundos. El defecto de motor son 30 s, que con Mongo
# caido bloquean al consumidor en cada intento.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000


# cleanup-job
#
# Unico componente que no sirve HTTP: no publica puerto y solo habla con Mongo. Su auditoria es el
# log, con un `deleted_count` por pasada. ADR-005 renuncia al indice TTL a proposito, asi que sin
# este contenedor vivo no caduca nada.

# Nombre en el campo `service` de sus logs.
CLEANUP_SERVICE_NAME=cleanup-job

# Cada cuanto corre el barrido, en segundos. La primera pasada sale al arrancar.
CLEANUP_INTERVAL_SECONDS=60

# Antiguedad a partir de la cual se borra una notificacion, en horas. Admite decimales para probar
# sin esperar un dia; el codigo rechaza 0, que vaciaria la coleccion.
RETENTION_HOURS=24

# Una sola pasada y salir, en vez del planificador. Borra de verdad: no sirve como sonda de salud.
CLEANUP_RUN_ONCE=false

# Coleccion que se limpia. Mismo contrato de hecho que en notifier-service; el Compose no la pasa.
# MONGO_COLLECTION=notifications

# Seleccion de servidor de MongoDB, en milisegundos. El Compose no la pasa.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000


# Observabilidad
#
# `/health` y `/health/ready` dan el estado por dependencia y devuelven 503 si una critica esta
# caida; `/health/live` solo dice que el proceso responde, y es lo que miran los healthcheck del
# Compose. `/metrics` habla el formato de exposicion de Prometheus, sin ningun contenedor de
# Prometheus ni de Grafana en el Compose. Los publicadores y el cleanup-job no sirven HTTP: su salud
# se lee en el /metrics del proceso hermano que comparte almacen.

# Segundos que espera cada sonda de dependencia antes de darla por caida. Acota la respuesta de
# /health aunque el almacen no conteste.
HEALTH_PROBE_TIMEOUT_SECONDS=2

# Interfaz y puerto donde escuchan los dos consumidores dentro de su contenedor. El Compose ya fija
# HTTP_PORT en los servicios que lo necesitan.
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8000


# Datos de ejemplo (`make seed`)
#
# `scripts/seed.py` crea los pedidos por `POST /orders`, nunca por INSERT directo, para que el flujo
# entero se dispare: outbox, procesador, notificador. Los deja en PENDING y el sistema los completa.

# Cliente al que se cargan los pedidos de ejemplo; es el que se consulta luego en
# `GET /notifications/{customer_id}`.
SEED_CUSTOMER_ID=cafe-demo

# Cuantos pedidos crea cada ejecucion.
SEED_ORDERS=3

# Segundos que espera a que los pedidos lleguen a notificacion antes de rendirse.
SEED_TIMEOUT_SECONDS=60


# Pruebas de integracion
#
# `make test-integration` levanta un contenedor de un solo uso que ejecuta pytest dentro de la red
# del Compose: no hace falta Python en la maquina ni publicar ningun puerto. La suite no usa esperas
# fijas, sino condiciones del propio sistema con estos dos limites.

# Segundos que espera a que los cuatro procesos HTTP contesten /health/ready.
INTEGRATION_READY_TIMEOUT_SECONDS=90

# Segundos que espera cada paso del flujo: publicacion del outbox, transicion a COMPLETED y
# escritura de la notificacion.
INTEGRATION_FLOW_TIMEOUT_SECONDS=45
